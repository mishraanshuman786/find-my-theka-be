{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "sourceMap": true,
    "declaration": false,

    "skipLibCheck": true,

    "types": ["node"]
  },

  "include": [
    "drizzle/**/*.ts",
    "src/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}